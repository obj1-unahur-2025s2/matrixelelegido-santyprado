
import matrix.*
describe "Test de Neo " {

  test "Neo es elegido" {
    assert.that(Neo.esElElegido())
  }
  test "La vitalidad de Neo es 10"{
    assert.equals(10, Neo.vitalidad())
  }

  test"vitalidad de neo despues de un salto"{
    Neo.saltar()
    assert.equals(Neo.vitalidad(), 5)
  }
}
describe "Test de Morfeo " {

  test "Neo no es elegido" {
    assert.notThat(Morfeo.esElElegido())
  }
  test "La vitalidad de Morfeo "{
    assert.equals(8, Morfeo.vitalidad())
  }

  test"vitalidad de Morfeo despues de un salto"{
    Morfeo.saltar()
    assert.equals(Morfeo.vitalidad(), 7)
  }
 test "Morfeo salta y esta cansado,luego vuelve a saltar para estas de otra vez descansado"{
  Morfeo.saltar()
  assert.that(Morfeo.estaCansado())
  Morfeo.saltar()
  assert.notThat(Morfeo.estaCansado())
 }
}

describe "Test de trinity"{
  test "trinity no es la elegida" {
    assert.notThat(Trinity.esElElegido())
  }
  test "La vitalidad de Trinity "{
    assert.equals(0, Trinity.vitalidad())
  }

  test"vitalidad de Trinity despues de un salto"{
    Trinity.saltar()
    assert.equals(Trinity.vitalidad(), 0)
  }
}
describe "Test de la nave" {
  test "La cantidad de pasajeros que tiene la naveal inicio" {
    assert.equals(3, Nave.cantidadPasajeros())
  }
  test "El pasajero con mayor vitalidad que hay en la nave al inicio"{
    assert.equals(Neo, Nave.pasajeroMayorVitalidad())
  }
}